{
  "name": "@ruakit/react",
  "version": "0.1.0-alpha.5",
  "description": "Rua React toolbar and request hook",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toolbar": {
      "types": "./dist/lib/controlled.d.ts",
      "import": "./dist/lib/controlled.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../shared/scripts/minify.mjs && node scripts/build-react.mjs && node scripts/copy-styles.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:build": "node scripts/demo.mjs --build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ruakit/agent": "workspace:^",
    "@ruakit/schema": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "motion": "14.0.0",
    "@heroicons/react": "2.2.0",
    "esbuild": "0.28.2"
  }
}
