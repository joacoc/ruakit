{
  "name": "ruakit-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter './packages/**' -r build",
    "build": "pnpm build:packages",
    "test": "pnpm build:packages && vitest run",
    "test:e2e": "pnpm build:packages && pnpm --filter @ruakit/e2e test"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@ruakit/agent": "workspace:*",
    "@ruakit/react": "workspace:*"
  }
}
